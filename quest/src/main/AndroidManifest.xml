<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"

    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Verrou Wi-Fi basse latence (pas d'économie d'énergie Wi-Fi pendant le flux) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.type.vr_headset" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="Quest Mirror"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <layout android:defaultWidth="518dp" android:defaultHeight="1110dp" />
        </activity>

        <activity
            android:name=".XrActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <!-- Format exact de l'image du téléphone (896x1920) : aucune bande noire -->
            <layout android:defaultWidth="518dp" android:defaultHeight="1110dp" />
        </activity>

        <!-- Panneau bureau DeX : grande fenêtre paysage séparée (programme d'aide via start-dex.bat) -->
        <activity
            android:name=".DexActivity"
            android:exported="false"
            android:label="DeX"
            android:taskAffinity="com.example.quest.dex"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <layout android:defaultWidth="1280dp" android:defaultHeight="770dp" />
        </activity>

        <!-- Panneau volume : tâche séparée → panneau Horizon OS placé à côté du principal -->
        <activity
            android:name=".VolumeActivity"
            android:exported="false"
            android:label="Commandes"
            android:taskAffinity="com.example.quest.volume"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <layout android:defaultWidth="110dp" android:defaultHeight="760dp" />
        </activity>

    </application>

</manifest>
